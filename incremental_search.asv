function [x, info] = incremental_search(f, ~, interval, atol, maxit)
    arguments
        f function_handle
        ~
        interval (1, 2) double
        atol (1, 1) double {mustBePositive}
        maxit (1, 1) double {mustBeInteger, mustBePositive}
    end

    info = struct();
    info.flag = -1;
    info.history.funcCount = zeros(maxit, 1);
    info.history.x = zeros(maxit, 1);
    
    x_grid = linspace(interval(1), interval(2), maxit);
    best_x = x_grid(1);
    best_f = abs(f(best_x));
    func_evals = 0;
    
    for i = 1:maxit
        x_curr = x_grid(i);
        fx = f(x_curr);
        func_evals = func_evals + 1;
        
        % Track the estimate closest to f(x) = 0 so far
        if abs(fx) < best_f
            best_f = abs(fx);
            best_x = x_curr;
        end
        
        info.history.funcCount(i) = func_evals;
        info.history.x(i) = best_x;
        
        if abs(fx) <= atol
            x = x_curr;
            info.flag = 0;
            info.iter = i;
            info.fval = fx;
            info.history.funcCount = info.history.funcCount(1:i);
            info.history.x = info.history.x(1:i);
            return;
        end
    end
    
    x = best_x;
    info.iter = maxit;
    info.fval = f(x);
end